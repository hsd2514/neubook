DATABASE_URL=postgresql+psycopg2://postgres:0314@localhost:5432/vitodoo
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# Redis lock backend (recommended for production):
# Option 1: Standard Redis URL
# REDIS_URL=redis://localhost:6379/0
#
# Option 2: Upstash Redis URL (recommended if you use Upstash)
# UPSTASH_REDIS_URL=rediss://default:<password>@<host>:<port>

SLOT_LOCK_TTL_SECONDS=10

# PhonePe Payment Gateway (Python Backend SDK)
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=
# PHONEPE_ENV=SANDBOX
# PHONEPE_CALLBACK_USERNAME=
# PHONEPE_CALLBACK_PASSWORD=

